# Copy to .env (gitignored) and fill in. Spring loads this file on startup;
# real environment variables override it.

# --- AI provider (required for AI features) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Only for reasoning models (gpt-oss, qwen3): low | medium | high. Leave empty for other models.
GROQ_REASONING_EFFORT=low

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cvpilot
DB_USERNAME=cvpilot
DB_PASSWORD=change-me

# --- HTTP ---
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Abuse protection ---
AI_DAILY_REQUEST_LIMIT=500
AI_RATE_LIMIT_REQUESTS=20
AI_RATE_LIMIT_WINDOW=10m

# --- PDF export: LaTeX compiler (Tectonic). Path or command on PATH. ---
LATEX_COMPILER=tectonic
